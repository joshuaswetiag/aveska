# Database
# Scoop/local Postgres (trust auth, no password):
DATABASE_URL="postgresql://postgres@localhost:5432/aveska?schema=public"
# Docker Compose alternative:
# DATABASE_URL="postgresql://aveska:aveska@localhost:5432/aveska?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="generate-a-long-random-string"
# Public URL of this app. Required for worldwide email click tracking.
# On Railway, Generate Domain then set both to https://${{RAILWAY_PUBLIC_DOMAIN}}
# TRACKING_URL="https://aveska-production.up.railway.app"
AUTH_URL="http://localhost:3000"

# Optional: seed admin (used only by prisma/seed.ts)
ADMIN_EMAIL="admin@aveska.local"
ADMIN_PASSWORD="change-me"

# AI provider (optional — template generator is used when unset)
# openai | openai-compatible | none
AI_PROVIDER="none"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_BASE_URL=""

# Email — Resend on Railway (HTTPS). SMTP/Gmail only works on this PC or Railway Pro.
EMAIL_PROVIDER="resend"
EMAIL_SEND_DELAY_MS="200"
RESEND_API_KEY=""
SMTP_FROM="hello@your-verified-domain.com"
SMTP_FROM_NAME="Aveska"
SMTP_REPLY_TO=""
MAROPOST_ACCOUNT_ID=""
MAROPOST_API_KEY=""
MAROPOST_CAMPAIGN_NAME="aveska-intelligence"

# App
NEXT_PUBLIC_APP_NAME="Aveska Intelligence"
NEXT_PUBLIC_COMPANY_NAME="Aveska"
MAX_UPLOAD_MB="25"

# Neto / Maropost (optional live catalogue sync)
NETO_API_URL="https://www.aveska.com.au/do/WS/NetoAPI"
NETO_API_KEY=""
NETO_API_USERNAME=""
