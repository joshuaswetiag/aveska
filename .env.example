# Database
# Scoop/local Postgres (trust auth, no password):
DATABASE_URL="postgresql://postgres@localhost:5432/aveska?schema=public"
# Docker Compose alternative:
# DATABASE_URL="postgresql://aveska:aveska@localhost:5432/aveska?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="generate-a-long-random-string"
# Public URL of this app. Required for email click tracking (Gmail cannot reach localhost).
# On Railway, set both to https://your-service.up.railway.app after Generate Domain.
# TRACKING_URL="https://intelligence.your-domain.com"
AUTH_URL="http://localhost:3000"

# Optional: seed admin (used only by prisma/seed.ts)
ADMIN_EMAIL="admin@aveska.local"
ADMIN_PASSWORD="change-me"

# AI provider (optional — template generator is used when unset)
# openai | openai-compatible | none
AI_PROVIDER="none"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_BASE_URL=""

# Email / SMTP
# Preferred: save SMTP under Settings in the app.
# These .env values are only a fallback if Settings is empty.
EMAIL_PROVIDER="export"
EMAIL_SEND_DELAY_MS="200"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_FROM_NAME="Aveska"
SMTP_REPLY_TO=""
MAROPOST_ACCOUNT_ID=""
MAROPOST_API_KEY=""
MAROPOST_CAMPAIGN_NAME="aveska-intelligence"

# App
NEXT_PUBLIC_APP_NAME="Aveska Intelligence"
NEXT_PUBLIC_COMPANY_NAME="Aveska"
MAX_UPLOAD_MB="25"

# Neto / Maropost (optional live catalogue sync)
NETO_API_URL="https://www.aveska.com.au/do/WS/NetoAPI"
NETO_API_KEY=""
NETO_API_USERNAME=""
